+// A percentile tie is not necessarily a flat list: worse nets can remain
+// below the tied anchor and must still receive the configured maximum.
+TEST(TimingNetWeight, TiedAnchorSaturatesMoreCriticalTail)
+{
+  EXPECT_FLOAT_EQ(timingNetWeight(-10e-9f, -1e-9f, -1e-9f, 5.0f), 5.0f);
+  EXPECT_FLOAT_EQ(timingNetWeight(-10e-9f, -1e-9f, -1e-9f, 3.0f), 3.0f);
+  EXPECT_FLOAT_EQ(timingNetWeight(-10e-9f, -1e-9f, -1e-9f, 1.0f), 1.0f);
+}
+
+TEST(TimingNetWeight, TiedAnchorLeavesCeilingAndBetterNetsAtOne)
+{
+  EXPECT_FLOAT_EQ(timingNetWeight(-1e-9f, -1e-9f, -1e-9f, 5.0f), 1.0f);
+  EXPECT_FLOAT_EQ(timingNetWeight(0.0f, -1e-9f, -1e-9f, 5.0f), 1.0f);
+}
+
+TEST(TimingNetWeight, TiedPercentilePreservesTailAcrossListSizes)
+{
+  for (const size_t count : {49u, 50u, 99u, 100u, 150u, 1000u}) {
+    SCOPED_TRACE(count);
+    std::vector<float> slacks(count, -1e-9f);
+    slacks.front() = -10e-9f;
+    const float anchor = slacks[slackRampAnchorIndex(count)];
+    EXPECT_FLOAT_EQ(
+        timingNetWeight(slacks.front(), anchor, slacks.back(), 5.0f), 5.0f);
+    EXPECT_FLOAT_EQ(
+        timingNetWeight(slacks.back(), anchor, slacks.back(), 5.0f), 1.0f);
+  }
+}
+
+TEST(TimingNetWeight, InfiniteTiesRemainUnweighted)
+{
+  const float infinity = std::numeric_limits<float>::infinity();
+  EXPECT_FLOAT_EQ(timingNetWeight(-1.0f, infinity, infinity, 5.0f), 1.0f);
+  EXPECT_FLOAT_EQ(timingNetWeight(-1.0f, -infinity, -infinity, 5.0f), 1.0f);
+}
+
+TEST(TimingNetWeight, ReversedRampRemainsUnweighted)
+{
+  EXPECT_FLOAT_EQ(timingNetWeight(-10.0f, 1.0f, -1.0f, 5.0f), 1.0f);
+}
+
