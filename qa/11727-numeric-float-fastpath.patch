 #include "gtest/gtest.h"
 #include "src/gpl/src/timingBase.h"
@@ -25,5 +26,25 @@ TEST(TimingNetWeight, FlatRampLeavesWeightsAtOne)
   EXPECT_NEAR(computeTimingNetWeight(1.0f, 1.0f, 1.0f, 5.0f), 1.0f, kTolerance);
 }
 
+// The endpoints can be finite while their float difference overflows.
+TEST(TimingNetWeight, FiniteWideRangeHasCorrectMidpointAndQuarter)
+{
+  constexpr float kHuge = std::numeric_limits<float>::max();
+  EXPECT_FLOAT_EQ(computeTimingNetWeight(0.0f, -kHuge, kHuge, 5.0f), 3.0f);
+  EXPECT_FLOAT_EQ(
+      computeTimingNetWeight(-kHuge / 2, -kHuge, kHuge, 5.0f), 4.0f);
+}
+
+// A malformed timing value must not propagate NaN or infinity to placement.
+TEST(TimingNetWeight, RejectsNonFiniteInputs)
+{
+  const float inf = std::numeric_limits<float>::infinity();
+  const float nan = std::numeric_limits<float>::quiet_NaN();
+  EXPECT_FLOAT_EQ(computeTimingNetWeight(nan, -1.0f, 1.0f, 5.0f), 1.0f);
+  EXPECT_FLOAT_EQ(computeTimingNetWeight(0.0f, nan, 1.0f, 5.0f), 1.0f);
+  EXPECT_FLOAT_EQ(computeTimingNetWeight(0.0f, -1.0f, inf, 5.0f), 1.0f);
+  EXPECT_FLOAT_EQ(computeTimingNetWeight(0.0f, -1.0f, 1.0f, inf), 1.0f);
+}
