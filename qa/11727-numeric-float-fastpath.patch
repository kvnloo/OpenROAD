diff --git a/src/gpl/src/timingBase.cpp b/src/gpl/src/timingBase.cpp
index cf89ea4..67507c5 100644
--- a/src/gpl/src/timingBase.cpp
+++ b/src/gpl/src/timingBase.cpp
@@ -44,9 +44,26 @@ float computeTimingNetWeight(const float net_slack,
   if (slack_max <= slack_min) {
     return 1.0f;
   }
-  const float criticality = std::clamp(
-      (slack_max - net_slack) / (slack_max - slack_min), 0.0f, 1.0f);
-  return 1.0f + (net_weight_max - 1.0f) * criticality;
+  // Invalid slacks and weights must not reach Nesterov placement forces.
+  if (!std::isfinite(net_slack) || !std::isfinite(slack_min)
+      || !std::isfinite(slack_max) || !std::isfinite(net_weight_max)) {
+    return 1.0f;
+  }
+
+  // Preserve ordinary float rounding; only exceptional arithmetic needs
+  // double-precision interpolation.
+  const float span = slack_max - net_slack;
+  const float range = slack_max - slack_min;
+  if (std::isfinite(span) && std::isfinite(range) && range > 0.0f) {
+    const float criticality = std::clamp(span / range, 0.0f, 1.0f);
+    return 1.0f + (net_weight_max - 1.0f) * criticality;
+  }
+  const double criticality = std::clamp(
+      (static_cast<double>(slack_max) - net_slack)
+          / (static_cast<double>(slack_max) - slack_min),
+      0.0,
+      1.0);
+  return 1.0f + (net_weight_max - 1.0f) * static_cast<float>(criticality);
 }
 
